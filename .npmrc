# This project needs native postinstall builds (better-sqlite3, electron, esbuild).
# The user's global pnpm config sets ignore-scripts=true; we re-enable it only here,
# and restrict which packages may run scripts via `pnpm.onlyBuiltDependencies` in
# package.json. Do not remove that allowlist.
ignore-scripts=false

node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true
